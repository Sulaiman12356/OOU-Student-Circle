rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email == 'ipesolasulaiman@gmail.com')
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email == 'ipesolasulaiman@gmail.com') ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin' ||
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'SUPER_ADMIN'
        ))
      );
    }

    // ADMINS COLLECTION (RBAC & Access Control)
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSuperAdmin() || (isSignedIn() && request.auth.uid == adminId && request.auth.token.email == 'ipesolasulaiman@gmail.com');
      allow update: if isSuperAdmin() || (isAdmin() && request.auth.uid == adminId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'status']));
      allow delete: if isSuperAdmin() && adminId != request.auth.uid;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Allow listing for Student Connect queries and directory
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.role in [
          'student', 'client', 'aspirant', 'campus_shop_owner', 'market_vendor', 'service_provider',
          'STUDENT', 'CLIENT', 'ASPIRANT', 'CAMPUS_SHOP_OWNER', 'MARKET_VENDOR', 'SERVICE_PROVIDER'
        ]
        && request.resource.data.fullName is string && request.resource.data.fullName.size() <= 120;
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'id']))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // SERVICES COLLECTION
    match /services/{serviceId} {
      allow read: if true; // Public marketplace
      allow create: if isSignedIn() 
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 150
        && request.resource.data.startingPrice is number;
      allow update: if (isSignedIn() && resource.data.studentId == request.auth.uid)
        || isAdmin();
      allow delete: if (isSignedIn() && resource.data.studentId == request.auth.uid)
        || isAdmin();
    }

    // JOBS COLLECTION
    match /jobs/{jobId} {
      allow read: if true; // Public job board
      allow create: if isSignedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 150
        && request.resource.data.budget is number;
      allow update: if (isSignedIn() && resource.data.clientId == request.auth.uid)
        || isAdmin();
      allow delete: if (isSignedIn() && resource.data.clientId == request.auth.uid)
        || isAdmin();
    }

    // PROPOSALS COLLECTION
    match /proposals/{proposalId} {
      allow get: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.coverMessage is string && request.resource.data.coverMessage.size() <= 2000;
      allow update: if (isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isAdmin()
      ));
      allow delete: if (isSignedIn() && resource.data.studentId == request.auth.uid) || isAdmin();
    }

    // CONVERSATIONS & MESSAGES
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn() 
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 10;
      allow update: if isSignedIn() && (
        (request.auth.uid in resource.data.participants && request.resource.data.participants == resource.data.participants)
        || isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
          isAdmin()
        );
        allow create: if isSignedIn() 
          && request.resource.data.senderId == request.auth.uid
          && (
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
            isAdmin()
          )
          && request.resource.data.text is string && request.resource.data.text.size() <= 5000;
        allow update: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
          isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    // REVIEWS COLLECTION
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() 
        && request.resource.data.userId is string
        && request.resource.data.title is string && request.resource.data.title.size() <= 200;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // VERIFICATION REQUESTS
    match /verificationRequests/{requestId} {
      allow read: if (isSignedIn() && resource.data.studentId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // REPORTS
    match /reports/{reportId} {
      allow read: if (isSignedIn() && resource.data.reporterId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // TRANSACTIONS
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (
        resource.data.payerId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ADMIN LOGS, SECURITY EVENTS & SETTINGS
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /securityEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /platformSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // MARKETPLACE RULES
    // ==========================================

    // VENDORS COLLECTION
    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.studentId == request.auth.uid || request.resource.data.id == request.auth.uid);
      allow update: if (isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.id == request.auth.uid)) || isAdmin();
      allow delete: if isAdmin();
    }

    // PRODUCTS COLLECTION
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.vendorId == request.auth.uid || isAdmin());
      allow update: if (isSignedIn() && resource.data.vendorId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.vendorId == request.auth.uid) || isAdmin();
    }

    // PRODUCT CATEGORIES
    match /productCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ORDERS
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.customerId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // VENDOR SUB-ORDERS
    match /vendorOrders/{vendorOrderId} {
      allow read: if isSignedIn() && (resource.data.vendorId == request.auth.uid || resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if (isSignedIn() && (resource.data.vendorId == request.auth.uid || resource.data.customerId == request.auth.uid)) || isAdmin();
      allow delete: if isAdmin();
    }

    // PRODUCT REVIEWS
    match /productReviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // VENDOR REVIEWS
    match /vendorReviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // PAYOUT REQUESTS
    match /payoutRequests/{payoutId} {
      allow read: if (isSignedIn() && resource.data.vendorId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.vendorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // PROMOTIONS
    match /promotions/{promoId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.vendorId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.vendorId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // PRODUCT REPORTS
    match /productReports/{reportId} {
      allow read: if (isSignedIn() && resource.data.reporterId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // MARKETPLACE TRANSACTIONS
    match /marketplaceTransactions/{txId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.vendorId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // MARKETPLACE SETTINGS
    match /marketplaceSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CAMPUS LOCATIONS & ZONES
    match /campusLocations/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CAMPUS SHOPS & KIOSKS
    match /campusShops/{shopId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || request.resource.data.id == request.auth.uid);
      allow update: if (isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.id == request.auth.uid)) || isAdmin();
      allow delete: if isAdmin();
    }

    // PRINT JOBS & DOCUMENT ORDERS
    match /printJobs/{jobId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.shopOwnerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.shopOwnerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ASPIRANT REGISTRATIONS (Verification records kept private)
    match /aspirantRegistrations/{regId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // STUDENT CONNECT: CONNECTION REQUESTS
    match /connectionRequests/{reqId} {
      allow read: if (isSignedIn() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      )) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if (isSignedIn() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      )) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.senderId == request.auth.uid) || isAdmin();
    }

    // STUDENT CONNECT: ESTABLISHED CONNECTIONS
    match /studentConnections/{connId} {
      allow read: if (isSignedIn() && (
        resource.data.user1Id == request.auth.uid || 
        resource.data.user2Id == request.auth.uid ||
        request.auth.uid in resource.data.users
      )) || isAdmin();
      allow create: if isSignedIn() && (
        request.resource.data.user1Id == request.auth.uid || 
        request.resource.data.user2Id == request.auth.uid
      );
      allow update: if isAdmin();
      allow delete: if (isSignedIn() && (
        resource.data.user1Id == request.auth.uid || 
        resource.data.user2Id == request.auth.uid
      )) || isAdmin();
    }

    // STUDENT PRIVACY SETTINGS
    match /userPrivacySettings/{userId} {
      allow read: if isSignedIn();
      allow write: if (isSignedIn() && userId == request.auth.uid) || isAdmin();
    }

    // ==========================================
    // MODULE 6: JOBS & OPPORTUNITIES RULES
    // ==========================================

    // OPPORTUNITIES COLLECTION
    match /opportunities/{opportunityId} {
      // Approved opportunities are publicly readable; creators and admins can read unapproved/draft/pending ones
      allow read: if resource.data.moderationStatus == 'approved' 
        || (isSignedIn() && resource.data.creatorId == request.auth.uid)
        || isAdmin();
      
      // Signed in users can create opportunities
      allow create: if isSignedIn() 
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.opportunityType in ['job', 'internship', 'scholarship', 'competition', 'fellowship', 'project', 'program']
        && (isAdmin() || request.resource.data.moderationStatus in ['pending', 'draft']);

      // Creator can update if not suspended, or Admin can update everything (moderation, status, notes)
      allow update: if (isSignedIn() && resource.data.creatorId == request.auth.uid && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['moderationStatus', 'moderatedBy', 'moderatedAt']) || isAdmin()))
        || isAdmin();

      // Creator or Admin can delete
      allow delete: if (isSignedIn() && resource.data.creatorId == request.auth.uid) || isAdmin();
    }

    // OPPORTUNITY APPLICATIONS COLLECTION
    match /opportunityApplications/{applicationId} {
      // Applicant, opportunity creator (job owner), or Admin can view applications
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );

      // Student can submit application for themselves
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.coverMessage is string && request.resource.data.coverMessage.size() <= 4000;

      // Student can update own pending application, or Job Owner / Admin can update application status (shortlist, reject, hire, award)
      allow update: if isSignedIn() && (
        (resource.data.studentId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'reviewerNotes'])) ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );

      // Student or Admin can delete application
      allow delete: if (isSignedIn() && resource.data.studentId == request.auth.uid) || isAdmin();
    }

    // ==========================================
    // MODULE 7: UNIFIED TRANSACTION ENGINE RULES
    // ==========================================

    // TRANSACTION REQUESTS COLLECTION
    match /transactionRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.type in ['service', 'product', 'campus_service', 'job'];
      allow update: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if (isSignedIn() && resource.data.buyerId == request.auth.uid) || isAdmin();
    }

    // TRANSACTION QUOTES COLLECTION
    match /transactionQuotes/{quoteId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.deliveryTime is string;
      allow update: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if (isSignedIn() && resource.data.sellerId == request.auth.uid) || isAdmin();
    }

    // UNIFIED ORDERS COLLECTION
    match /unifiedOrders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.buyerId == request.auth.uid ||
        request.resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ORDER DISPUTES COLLECTION
    match /orderDisputes/{disputeId} {
      allow read: if isSignedIn() && (
        resource.data.openedById == request.auth.uid ||
        resource.data.againstId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.openedById == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.description is string;
      allow update: if isSignedIn() && (
        resource.data.openedById == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // UNIFIED REVIEWS COLLECTION
    match /unifiedReviews/{reviewId} {
      allow read: if true; // Public verified reviews for student profiles & portfolios
      allow create: if isSignedIn()
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string;
      allow update: if (isSignedIn() && resource.data.reviewerId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
